#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from http import HTTPStatus
from urllib.error import HTTPError, URLError
from urllib.parse import urljoin, urlparse
from urllib.request import Request, urlopen


def die(*msg):
    # https://buildkite.com/docs/pipelines/managing-log-output#collapsing-output
    print("^^^ +++", file=sys.stderr)
    print("🚨 Trusted publishing exchange failure:", file=sys.stderr)
    print(*msg, sep="\n", file=sys.stderr)
    sys.exit(1)


repository_url = os.getenv(
    "BUILDKITE_PLUGIN_PYPI_OIDC_REPOSITORY_URL",
    "https://upload.pypi.org/legacy/",
)
repository_domain = urlparse(repository_url).netloc

# Indices are expected to support `https://{domain}/_/oidc/audience`,
# which tells OIDC exchange clients which audience to use.
audience_url = urljoin(repository_url, "/_/oidc/audience")
try:
    audience_response = urlopen(audience_url)
except HTTPError as err:
    match err.code:
        case HTTPStatus.FORBIDDEN:
            # This index supports OIDC, but forbids the client from using
            # it (either because it's disabled, ratelimited, etc.)
            die(
                f"audience retrieval failed: repository at {repository_domain} has trusted publishing disabled"
            )
        case HTTPStatus.NOT_FOUND:
            # This index does not support OIDC.
            die(
                f"audience retrieval failed: repository at {repository_domain} does not indicate trusted publishing support"
            )
        case _:
            die(
                f"audience retrieval failed: repository at {repository_domain} responded with {err.code}: {err.reason}"
            )
except URLError as err:
    die(
        f"audience retrieval failed: {err.reason}",
        "Check repository_url and network access to the repository.",
    )

if audience_response.status != 200:
    die(f"audience retrieval failed: expected HTTP 200, got {audience_response.status}")

oidc_audience = json.load(audience_response)["audience"]
oidc_lifetime = os.getenv("BUILDKITE_PLUGIN_PYPI_OIDC_LIFETIME", "60")

try:
    oidc_process = subprocess.run(
        [
            "buildkite-agent",
            "oidc",
            "request-token",
            "--audience",
            oidc_audience,
            "--lifetime",
            oidc_lifetime,
            "--claim",
            "organization_id,pipeline_id,jti",
        ],
        text=True,
        capture_output=True,
    )
except OSError as err:
    die(
        f"Unable to run buildkite-agent: {err}",
        "Install Buildkite agent v3.45.0+ and ensure buildkite-agent is on PATH.",
        "Run this plugin inside a Buildkite job, not from a local shell.",
    )

if oidc_process.returncode != 0 or not oidc_process.stdout.strip():
    die(
        "buildkite-agent oidc request-token failed or returned an empty token:",
        oidc_process.stderr.strip(),
        "Use Buildkite agent v3.45.0+ (required for --claim) inside a running Buildkite job.",
        "Check the agent error above and its connectivity to Buildkite; do not paste tokens into logs.",
        "See https://buildkite.com/docs/agent/v3/cli-oidc",
    )

oidc_token = oidc_process.stdout.strip()

token_url = urljoin(repository_url, "/_/oidc/mint-token")
token_data = json.dumps({"token": oidc_token})
token_request = Request(
    token_url,
    headers={"Content-Type": "application/json"},
    data=token_data.encode("utf-8"),
)
try:
    token_response = urlopen(token_request)
except HTTPError as err:
    # Python warehouse returns a 422 as detailed errors in json
    if err.code == 422:
        die(
            f"token exchange failed: {err.code} {err.reason}:",
            *(
                f"* `{error['code']}`: {error['description']}"
                for error in json.load(err)["errors"]
            ),
        )
    else:
        die(f"token exchange failed: {err.code} {err.reason}:", err.read())
except URLError as err:
    die(
        f"token exchange failed: {err.reason}",
        "Check repository_url and network access to the repository.",
    )

print(json.load(token_response)["token"], end="")
